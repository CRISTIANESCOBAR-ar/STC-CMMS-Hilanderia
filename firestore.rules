rules_version = '2';

// Producción S3: aprobación de altas, roles, sectores y operaciones.
// Ver docs/MATRIZ_PERMISOS_PRODUCCION.md y las pruebas del emulador.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function uid() {
      return request.auth.uid;
    }

    function userPath() {
      return /databases/$(database)/documents/usuarios/$(uid());
    }

    function userDoc() {
      return get(userPath());
    }

    function userExists() {
      return exists(userPath());
    }

    function userRole() {
      return userExists() ? userDoc().data.get('role', '') : '';
    }

    function isAdmin() {
      return isSignedIn() && userRole() == 'admin';
    }

    function isJefe() {
      return isSignedIn() && userRole() in [
        'jefe_sector', 'jefe_electricos', 'jefe_produccion', 'gerente_produccion'
      ];
    }

    function isStaff() {
      return isAdmin() || isJefe();
    }

    function noPrivilegeEscalation() {
      // Allowlist also protects future permission fields, deletion and legacy docs.
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['displayName', 'nombre']);
    }

    function validNewUser() {
      return request.resource.data.keys().hasOnly([
          'email', 'displayName', 'role', 'sectorDefault',
          'sectoresAsignados', 'alcance', 'jefeDeSectores', 'createdAt'
        ])
        && request.resource.data.role == 'pendiente'
        && request.resource.data.sectorDefault == 'HILANDERIA'
        && request.resource.data.sectoresAsignados == ['HILANDERIA']
        && request.resource.data.alcance == 'sector'
        && request.resource.data.jefeDeSectores == []
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.displayName is string
        && request.resource.data.createdAt == request.time;
    }

    // ── Usuarios ─────────────────────────────────────────────────
    match /usuarios/{userId} {
      allow read: if isSignedIn() && (uid() == userId || isMember());
      allow create: if isSignedIn()
        && uid() == userId
        && validNewUser();
      allow update: if isSignedIn() && (
        (uid() == userId && noPrivilegeEscalation())
        || isAdmin()
      );
      allow delete: if isAdmin();
    }

    // ── Configuración ───────────────────────────────────────────
    match /config/{docId} {
      allow read: if isSignedIn() && (docId == 'organization' || isMember());
      allow write: if isAdmin();
    }

    // ── Catálogos y administración ──────────────────────────────
    match /maquinas/{docId} {
      allow read: if isMember();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (isStaff() && scoped(resource.data) && stableIdentity());
    }

    match /catalogo_puestos_control/{docId} {
      allow read: if isMember();
      allow write: if isAdmin();
    }

    match /codigos_defectos/{docId} {
      allow read: if isMember();
      allow write: if isAdmin();
    }

    match /codigos_paradas/{docId} {
      allow read: if isMember();
      allow write: if isAdmin();
    }

    match /sintomas/{docId} {
      allow read: if isMember();
      allow write: if isAdmin();
    }

    match /motivos_tipo/{docId} {
      allow read: if isMember();
      allow write: if isAdmin();
    }

    match /rutas_patrulla/{docId} {
      allow read: if isMember();
      allow write: if isAdmin();
    }

    function isMember() {
      return isSignedIn() && userRole() in ['admin', 'mecanico', 'tejedor', 'inspector',
        'auxiliar', 'supervisor', 'supervisor_mecanico', 'supervisor_electrico',
        'jefe_sector', 'jefe_electricos', 'jefe_produccion', 'gerente_produccion'];
    }

    function assignedSectors() {
      let profile = userDoc().data;
      return profile.get('sectoresAsignados', [profile.get('sectorDefault', 'HILANDERIA')]);
    }

    function leaderSectors() {
      return isJefe() ? userDoc().data.get('jefeDeSectores', []) : [];
    }

    function sectorAccess(sector) {
      return isMember() && sector in ['HILANDERIA', 'TEJEDURIA']
        && (isAdmin() || sector in assignedSectors() || sector in leaderSectors());
    }

    function scoped(data) {
      return isMember() && (isAdmin() || sectorAccess(data.get('sector', '')));
    }

    function roleOverrides() {
      let path = /databases/$(database)/documents/config/organization;
      return exists(path) ? get(path).data.get('profiles', {}).get(userRole(), {}) : {};
    }

    function hasView(slug, defaults) {
      let personal = userDoc().data.get('vistasPersonalizadas', null);
      let configured = roleOverrides().get('vistas', null);
      return isMember() && (isAdmin() || (personal is list ? slug in personal
        : (configured is list ? slug in configured : userRole() in defaults)));
    }

    function hasPermission(name, defaults) {
      let personal = userDoc().data.get('permisosPersonalizados', null);
      let configured = roleOverrides().get('permisos', null);
      return isMember() && (isAdmin() || (personal is map ? personal.get(name, false) == true
        : (configured is map ? configured.get(name, false) == true : userRole() in defaults)));
    }

    function canReport() {
      return hasPermission('crearFalla', ['mecanico', 'tejedor', 'inspector', 'supervisor',
        'supervisor_mecanico', 'supervisor_electrico', 'jefe_sector', 'jefe_electricos',
        'jefe_produccion', 'gerente_produccion']);
    }

    function canDispatch() {
      return hasView('llamar', ['inspector', 'supervisor', 'supervisor_mecanico',
        'supervisor_electrico', 'jefe_sector', 'jefe_electricos', 'jefe_produccion', 'gerente_produccion']);
    }

    function canReadQuality() {
      return hasPermission('verCalidad', ['inspector', 'auxiliar', 'supervisor',
        'supervisor_mecanico', 'supervisor_electrico', 'jefe_sector', 'jefe_electricos',
        'jefe_produccion', 'gerente_produccion']);
    }

    function canExecute(data) {
      return hasPermission('cerrarOrden', ['mecanico', 'supervisor_mecanico',
        'supervisor_electrico', 'jefe_sector', 'jefe_electricos', 'jefe_produccion', 'gerente_produccion'])
        || (userRole() == 'inspector' && data.get('tipoIntervencion', '') == 'CALIDAD');
    }

    function stableIdentity() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'sector', 'createdAt', 'creadoPorUid', 'creadoPorNombre', 'creadoPorEmail',
        'inspectorUid', 'inspectorNombre', 'inspectorEmail', 'fecha', 'turno'
      ]);
    }

    function validCreation() {
      return scoped(request.resource.data)
        && request.resource.data.creadoPorUid == uid()
        && request.resource.data.createdAt == request.time;
    }

    function tejeduriaRead() {
      return sectorAccess('TEJEDURIA');
    }

    function productionWrite(view, defaults) {
      return tejeduriaRead() && hasView(view, defaults);
    }

    match /novedades/{docId} {
      allow read: if scoped(resource.data);
      allow create: if validCreation() && canReport() && request.resource.data.estado == 'pendiente'
        && !request.resource.data.keys().hasAny(['intervencionId','atencionEstado','atendidoPorUid','atendidoPorNombre']);
      allow update: if scoped(resource.data) && stableIdentity()
        && hasView('jefe', ['jefe_sector', 'jefe_electricos', 'jefe_produccion', 'gerente_produccion'])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado', 'feedbackJefe', 'updatedAt'])
        && request.resource.data.estado in ['pendiente', 'en proceso', 'resuelto']
        && (resource.data.get('intervencionId', null) == null || request.resource.data.estado == resource.data.estado)
        && request.resource.data.updatedAt == request.time;
      allow delete: if isAdmin() && resource.data.get('intervencionId', null) == null;
    }

    match /intervenciones/{docId} {
      allow read: if scoped(resource.data);
      allow create: if validCreation() && canDispatch()
        && !docId.matches('reporte_.*')
        && !request.resource.data.keys().hasAny(['atencionVersion', 'atencionEstado', 'atencionRevision', 'atencionUpdatedAt', 'reporteOrigenId'])
        && request.resource.data.estado == 'PENDIENTE'
        && request.resource.data.asignadoA == null
        && request.resource.data.fechaInicio == null && request.resource.data.fechaFin == null;
      allow update: if scoped(resource.data) && stableIdentity() && canExecute(resource.data)
        && !resource.data.keys().hasAny(['atencionVersion'])
        && (
          (resource.data.estado == 'PENDIENTE'
            && request.resource.data.estado == 'EN_PROCESO' && request.resource.data.asignadoA == uid()
            && request.resource.data.fechaInicio == request.time
            && request.resource.data.fechaAsignacion == request.time
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'estado', 'asignadoA', 'asignadoNombre', 'fechaInicio', 'fechaAsignacion']))
          || (resource.data.estado == 'EN_PROCESO' && resource.data.asignadoA == uid()
            && request.resource.data.asignadoA == resource.data.asignadoA
            && ((request.resource.data.estado == 'EN_PROCESO'
              && request.resource.data.diagnosticoUpdatedAt == request.time
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'causaRaiz', 'accionTomada', 'piezaId', 'piezaNombre', 'tiempoReal', 'tiempoAuto',
                'numeroCatalogo', 'numeroArticulo', 'diagnosticoUpdatedAt']))
              || (request.resource.data.estado == 'COMPLETADO'
                && request.resource.data.fechaFin == request.time
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado', 'fechaFin']))))
        );
      allow delete: if isAdmin() && !resource.data.keys().hasAny(['atencionVersion']);
      match /eventos_atencion/{eventId} {
        allow read: if scoped(get(/databases/$(database)/documents/intervenciones/$(docId)).data);
        allow write: if false;
      }
    }

    match /patrullas/{docId} {
      allow read: if scoped(resource.data) && canReadQuality();
      allow create: if scoped(request.resource.data) && canReadQuality() && request.resource.data.inspectorUid == uid()
        && request.resource.data.createdAt == request.time
        && (hasView('patrulla', ['inspector']) || hasView('eficiencia', ['supervisor', 'supervisor_mecanico']));
      // Inspectors may cover another inspector within their assigned sector.
      allow update: if scoped(resource.data) && canReadQuality() && stableIdentity()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rondas', 'estado'])
        && (hasView('patrulla', ['inspector'])
          || (hasView('eficiencia', ['supervisor', 'supervisor_mecanico'])
            && request.resource.data.estado == resource.data.estado
            && request.resource.data.rondas.diff(resource.data.get('rondas', {})).affectedKeys()
              .hasOnly(['ronda_e1', 'ronda_e2', 'ronda_e3'])));
      allow delete: if isAdmin();
    }

    match /notas_turno/{docId} {
      allow read: if scoped(resource.data);
      allow create: if validCreation() && canReport();
      allow update: if scoped(resource.data) && stableIdentity() && isStaff()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['leida']);
      allow delete: if isAdmin();
    }

    match /muestras_anudados/{docId} {
      allow read: if tejeduriaRead() && canReadQuality();
      allow create: if productionWrite('patrulla', ['inspector']) && canReadQuality()
        && request.resource.data.creadoPor == uid() && request.resource.data.createdAt == request.time;
      allow update, delete: if isAdmin();
    }

    match /shift_reports/{docId} {
      allow read: if tejeduriaRead();
      allow create, update: if productionWrite('shiftreport', ['auxiliar'])
        && request.resource.data.updatedAt == request.time;
      allow delete: if isAdmin();
    }

    match /operarios_horarios/{docId} {
      allow read: if tejeduriaRead();
      allow create, update: if productionWrite('operarios', ['auxiliar']);
      allow delete: if isAdmin();
    }

    match /paros_telares/{fecha}/registros/{registroId} {
      allow read: if tejeduriaRead();
      allow create, update: if productionWrite('paros-anudado', []);
      allow delete: if isAdmin();
    }

    match /ai_summaries/{docId} {
      allow read: if isMember() && (resource == null || isAdmin()
        || resource.data.get('sectores', []).size() > 0
          && resource.data.sectores.hasOnly(assignedSectors().concat(leaderSectors())));
      allow create, update: if isMember()
        && hasView('jefe', ['jefe_sector', 'jefe_electricos', 'jefe_produccion', 'gerente_produccion'])
        && request.resource.data.sectores.size() > 0
        && (isAdmin() || request.resource.data.sectores.hasOnly(assignedSectors().concat(leaderSectors())));
      allow delete: if isAdmin();
    }

    match /fcm_tokens/{userId} {
      allow read: if isMember() && (uid() == userId || isStaff());
      allow create, update: if isMember() && uid() == userId
        && (request.resource.data.get('turnoActivo', false) != true || request.resource.data.updatedAt == request.time);
      allow delete: if isSignedIn() && (uid() == userId || isAdmin());
    }

    // Denegar todo lo no declarado explícitamente
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
