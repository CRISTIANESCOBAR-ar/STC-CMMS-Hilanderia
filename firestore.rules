rules_version = '2';

// Producción S2: cuentas identificadas y perfiles protegidos.
// Los permisos operativos por sector/acción se incorporan en la entrega S3.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function uid() {
      return request.auth.uid;
    }

    function userPath() {
      return /databases/$(database)/documents/usuarios/$(uid());
    }

    function userDoc() {
      return get(userPath());
    }

    function userExists() {
      return exists(userPath());
    }

    function userRole() {
      return userExists() ? userDoc().data.get('role', '') : '';
    }

    function isAdmin() {
      return isSignedIn() && userRole() == 'admin';
    }

    function isJefe() {
      return isSignedIn() && userRole() in [
        'jefe_sector', 'jefe_electricos', 'jefe_produccion', 'gerente_produccion'
      ];
    }

    function isStaff() {
      return isAdmin() || isJefe();
    }

    function noPrivilegeEscalation() {
      // Allowlist also protects future permission fields, deletion and legacy docs.
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['displayName', 'nombre']);
    }

    function validNewUser() {
      return request.resource.data.keys().hasOnly([
          'email', 'displayName', 'role', 'sectorDefault',
          'sectoresAsignados', 'alcance', 'jefeDeSectores', 'createdAt'
        ])
        && request.resource.data.role == 'mecanico'
        && request.resource.data.sectorDefault == 'HILANDERIA'
        && request.resource.data.sectoresAsignados == ['HILANDERIA']
        && request.resource.data.alcance == 'sector'
        && request.resource.data.jefeDeSectores == []
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.displayName is string
        && request.resource.data.createdAt == request.time;
    }

    // ── Usuarios ─────────────────────────────────────────────────
    match /usuarios/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && uid() == userId
        && validNewUser();
      allow update: if isSignedIn() && (
        (uid() == userId && noPrivilegeEscalation())
        || isAdmin()
      );
      allow delete: if isAdmin();
    }

    // ── Configuración ───────────────────────────────────────────
    match /config/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ── Catálogos y administración ──────────────────────────────
    match /maquinas/{docId} {
      allow read: if isSignedIn();
      allow create, delete: if isAdmin();
      allow update: if isStaff();
    }

    match /catalogo_puestos_control/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /codigos_defectos/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /codigos_paradas/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /sintomas/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /motivos_tipo/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /rutas_patrulla/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ── Operación (mantener flujo actual para usuarios autenticados) ──
    match /novedades/{docId} {
      allow read, write: if isSignedIn();
    }

    match /intervenciones/{docId} {
      allow read, write: if isSignedIn();
    }

    match /patrullas/{docId} {
      allow read, write: if isSignedIn();
    }

    match /notas_turno/{docId} {
      allow read, write: if isSignedIn();
    }

    match /muestras_anudados/{docId} {
      allow read, write: if isSignedIn();
    }

    match /shift_reports/{docId} {
      allow read, write: if isSignedIn();
    }

    match /operarios_horarios/{docId} {
      allow read, write: if isSignedIn();
    }

    match /paros_telares/{fecha}/registros/{registroId} {
      allow read, write: if isSignedIn();
    }

    match /ai_summaries/{docId} {
      allow read, write: if isSignedIn();
    }

    match /fcm_tokens/{userId} {
      allow read: if isSignedIn() && (uid() == userId || isStaff());
      allow create, update: if isSignedIn() && uid() == userId;
      allow delete: if isSignedIn() && (uid() == userId || isAdmin());
    }

    // Denegar todo lo no declarado explícitamente
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
